# Docker PostgreSQL
POSTGRES_USER=resolver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resolver_network
POSTGRES_PORT=5432

# These URLs use the Docker Compose service hostname.
DATABASE_URL=postgres://resolver:change-me@postgres:5432/resolver_network?sslmode=disable
DATABASE_READ_URL=postgres://resolver:change-me@postgres:5432/resolver_network?sslmode=disable

# HTTP server
# Use 0.0.0.0 in containers; use 127.0.0.1 when running the API directly on the host.
HTTP_ADDR=0.0.0.0:8080
HTTP_PORT=8080

# Subgraph Studio Query Endpoint. Do not commit the real .env file.
GRAPH_ENDPOINT=https://gateway.thegraph.com/api/YOUR_API_KEY/subgraphs/id/YOUR_SUBGRAPH_ID
# JSON-RPC URL supporting eth_getBlockByNumber("finalized").
RPC_URL=https://YOUR_RPC_URL
# Private key for the on-chain rewardsUpdater account. Keep the real value secret.
REWARDS_UPDATER_PRIVATE_KEY=YOUR_PRIVATE_KEY
    
